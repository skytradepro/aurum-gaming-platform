# Copy this file to .env and adjust. Never commit the real .env file.
# The values below are placeholders for LOCAL DEVELOPMENT ONLY.

# --- API ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# PostgreSQL connection string. Create the database and the application role first (docs/SETUP.md).
DATABASE_URL=postgres://aurum_app:CHANGE_ME@localhost:5432/aurum
# Optional (local dev): postgres owner for npm run db:migrate. Leave unset in production.
# MIGRATE_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/aurum
# true when the database requires TLS (most managed PostgreSQL services do)
DATABASE_SSL=false
# Browser origin(s) allowed to call the API with a signed-in session (comma separated).
# Used for the CSRF / Origin checks. In production this must be https.
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
# true in production (HTTPS only): Secure cookies and the __Host- cookie prefix. Required in production.
COOKIE_SECURE=false
# Directory for uploaded banner/promotion/game images. Keep it outside the web root and back it up.
UPLOAD_DIR=./storage/uploads
# Demo catalogue, winners and jackpots for design work. The API refuses to start with this on in production.
SHOW_DEMO_DATA=true
# How many proxies sit in front of the API. The website server always sits in front of it and
# forwards the visitor's IP, so this is 1 for the standard setup (website -> API on the same machine).
TRUST_PROXY_HOPS=1
# debug | info | warn | error | silent
LOG_LEVEL=info

# Optional sign-in lifetimes
# SESSION_USER_DAYS=30
# SESSION_USER_IDLE_DAYS=7
# SESSION_STAFF_HOURS=12
# SESSION_STAFF_IDLE_MINUTES=30

# Optional CAPTCHA on registration (Cloudflare Turnstile). Leave both empty to disable it.
# Using it sends the visitor's token to Cloudflare, so decide on it deliberately.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# --- Web ---------------------------------------------------------------
# Where the website server reaches the API (server-side only, never exposed to browsers)
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Secret for the anti-forgery (CSRF) tokens: at least 32 random characters. Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEB_SECRET=
# How many reverse proxies sit in front of the website (1 with nginx in front, 0 when visited directly).
WEB_TRUST_PROXY_HOPS=0
# Time zone used to show dates on statements, dashboards and receipts.
DISPLAY_TIMEZONE=Africa/Tunis

# --- Tests -------------------------------------------------------------
# Local tests: a role with CREATEDB (recommended: aurum_test — see packages/db/scripts/create-local-test-role.sql).
# Point at maintenance DB "postgres"; each test run creates aurum_test_<random> and drops it.
# Never point this at production or at DATABASE_URL's database for real player data.
# TEST_DATABASE_URL=postgres://aurum_test:CHANGE_ME@localhost:5432/postgres

# Market exchange rates for the "about X" display (check the provider terms before launch)
RATES_API_URL=https://open.er-api.com/v6/latest/{BASE}

INHOUSE_GAMES=false
GAME_SECRET=

# Real football data (API-Football, api-sports.io). Leave empty to keep the football sections on "not available yet".
FOOTBALL_API_KEY=
# Seconds live results are cached. The free plan allows 100 requests a day: use 900 there.
FOOTBALL_LIVE_CACHE_SECONDS=120
# Percent taken off the provider odds (your margin) and the preferred bookmaker id (0 = first available)
FOOTBALL_ODDS_MARGIN_PERCENT=0
FOOTBALL_BOOKMAKER_ID=0
# Pages of the daily odds list (API-Football Free plan: max 3)
FOOTBALL_ODDS_MAX_PAGES=3

# Game aggregator (provider games: Pragmatic Play, Amatic, Evoplay...). Leave empty until the contract is signed.
# Values come from the aggregator. See docs/AGGREGATOR.md.
AGGREGATOR_NAME=
AGGREGATOR_API_URL=
AGGREGATOR_OPERATOR_ID=
AGGREGATOR_SECRET=
AGGREGATOR_SIGNATURE_HEADER=x-signature
AGGREGATOR_SESSION_MINUTES=240

# API LX (Pragmatic / Amatic / PGSoft / Amusnet). Leave empty until staging credentials are set. Never commit real secrets.
# Callback base registered with LX: https://YOUR-DOMAIN/api/v1/apilx/wallet
APILX_AGENT_ID=
APILX_PRAGMATIC_API_URL=
APILX_PRAGMATIC_TOKEN=
APILX_PRAGMATIC_SECRET=
APILX_AMATIC_API_URL=
APILX_AMATIC_TOKEN=
APILX_AMATIC_SECRET=
APILX_PGSOFT_API_URL=
APILX_PGSOFT_TOKEN=
APILX_PGSOFT_SECRET=
APILX_AMUSNET_API_URL=
APILX_AMUSNET_TOKEN=
APILX_AMUSNET_SECRET=
# After keys are set: npm run apilx:probe-gamelist -w @aurum/api -- pragmatic
# Then: npm run apilx:sync-catalog -w @aurum/api
# Or Super Admin: POST /v1/admin/apilx/sync?provider=pragmatic-play

# Bank transfer deposits: the account shown to players. Leave all five empty to hide the bank option.
# Transfers are matched by the player's reference and credited by staff from the admin panel.
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_BANK_ADDRESS=
BANK_TRANSFER_BIC=

# E-mail (Brevo transactional API). Empty = no e-mails; codes are still shown in the player's account.
# The sender address must be verified in Brevo. Keep the API key secret.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Hannibal

# Hannibal AI assistant (OpenRouter). Empty = assistant off.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
