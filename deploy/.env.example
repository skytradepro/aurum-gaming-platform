# Copy to deploy/.env on the SERVER and fill in. Never commit the real file.
# Domain or subdomain that points to the server (no https://, no path), e.g. test.example.com
SITE_ADDRESS=
# Same value as apps/web/.env.local ADMIN_SECRET_PATH (secret admin link when enabled in Admin → Settings).
ADMIN_SECRET_PATH=
# Optional team gate (only if basic_auth is enabled in deploy/Caddyfile):
#   docker run --rm caddy:2 caddy hash-password --plaintext 'YOUR-TEAM-PASSWORD'
# BASIC_AUTH_USER=team
# BASIC_AUTH_HASH=
# Database passwords (long random strings, letters and digits only)
POSTGRES_PASSWORD=
AURUM_APP_PASSWORD=
# Exchange-rate source (check the provider terms before launch)
RATES_API_URL=https://open.er-api.com/v6/latest/USD
# In-house demo games: keep false unless this is a closed internal test. Needs licensing before any public use.
# Real football data and sports betting (API-Football key)
FOOTBALL_API_KEY=
FOOTBALL_LIVE_CACHE_SECONDS=900
FOOTBALL_ODDS_MARGIN_PERCENT=0
FOOTBALL_BOOKMAKER_ID=0

INHOUSE_GAMES=false
# Required (32+ random characters) only when INHOUSE_GAMES=true
GAME_SECRET=
# Pages of the daily odds list (API-Football Free plan: max 3)
FOOTBALL_ODDS_MAX_PAGES=3

# Game aggregator (provider games: Pragmatic Play, Amatic, Evoplay...). Leave empty until the contract is signed.
# Values come from the aggregator. See docs/AGGREGATOR.md.
AGGREGATOR_NAME=
AGGREGATOR_API_URL=
AGGREGATOR_OPERATOR_ID=
AGGREGATOR_SECRET=
AGGREGATOR_SIGNATURE_HEADER=x-signature
AGGREGATOR_SESSION_MINUTES=240

# API LX — see root .env.example (APILX_AGENT_ID, APILX_* per provider)

# Hannibal AI assistant (OpenRouter). Empty = assistant off.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
